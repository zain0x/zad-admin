# MySQL connection. Local example:
DATABASE_URL="mysql://zad_admin:CHANGE_ME@127.0.0.1:3306/zad_admin"

# 32+ random characters. Encrypts 2FA secrets in the database.
# Generate one with:  openssl rand -base64 48
# Never change it after staff have enabled 2FA, or they will need a 2FA reset.
AUTH_SECRET=""

# Shared secret with zad-landing (ADMIN_API_SECRET there). Signs requests to /api/ingest.
# Generate with:  openssl rand -hex 32
INGEST_SECRET=""

# Optional: comma-separated IPs allowed to call /api/ingest (the zad.gg server).
# Leave empty locally. On the server, Nginx also restricts it.
INGEST_ALLOWED_IPS=""

# Base URL printed in certificate QR codes and links (the verification page on the landing site).
CERT_VERIFY_BASE_URL="https://zad.gg/cert"
