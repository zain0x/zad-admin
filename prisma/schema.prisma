// Zad Admin database schema (MySQL 8).
// Phase 1: staff accounts, sessions, 2FA backup codes, audit log.
// Phase 2: Zad Security requests from zad.gg/security, with notes.
// Phase 3: certificates (internship, attendance, course), verified at zad.gg/cert/<code>.
// Email monitoring: subscribed emails re-checked for breaches weekly or monthly, plus anonymous site-check stats.

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

enum Role {
    ADMIN
    STAFF
}

model User {
    id                 String    @id @default(cuid())
    email              String    @unique @db.VarChar(191)
    name               String    @db.VarChar(120)
    passwordHash       String    @map("password_hash") @db.VarChar(255)
    role               Role      @default(STAFF)
    isActive           Boolean   @default(true) @map("is_active")
    mustChangePassword Boolean   @default(true) @map("must_change_password")
    /// Sections a STAFF member may open (admins can open everything)
    permCertificates   Boolean   @default(false) @map("perm_certificates")
    permSites          Boolean   @default(false) @map("perm_sites")
    permEmails         Boolean   @default(false) @map("perm_emails")
    /// Encrypted with AUTH_SECRET (lib/auth/secret-box.ts)
    totpSecret         String?   @map("totp_secret") @db.VarChar(255)
    /// Secret shown during setup, before the first code confirms it
    totpPendingSecret  String?   @map("totp_pending_secret") @db.VarChar(255)
    totpEnabledAt      DateTime? @map("totp_enabled_at")
    /// Last accepted TOTP time step, so a code cannot be used twice
    totpLastStep       Int?      @map("totp_last_step")
    failedLoginCount   Int       @default(0) @map("failed_login_count")
    lockedUntil        DateTime? @map("locked_until")
    lastLoginAt        DateTime? @map("last_login_at")
    createdAt          DateTime  @default(now()) @map("created_at")
    updatedAt          DateTime  @updatedAt @map("updated_at")

    sessions         Session[]
    backupCodes      BackupCode[]
    auditLogs        AuditLog[]    @relation("actor")
    assignedRequests ScanRequest[] @relation("assignee")
    requestNotes     RequestNote[]
    certsIssued      Certificate[] @relation("certIssuer")
    certsRevoked     Certificate[] @relation("certRevoker")
    emailsAdded      MonitoredEmail[] @relation("emailAddedBy")
    requestsClosed   ScanRequest[]  @relation("requestCloser")
    findings         Finding[]      @relation("findingAuthor")
    requestFiles     RequestFile[]  @relation("fileUploader")

    @@map("users")
}

model Session {
    id              String   @id @default(cuid())
    /// SHA-256 of the cookie token; the token itself is never stored
    tokenHash       String   @unique @map("token_hash") @db.Char(64)
    userId          String   @map("user_id")
    twoFactorPassed Boolean  @default(false) @map("two_factor_passed")
    /// Set on the login that just enabled 2FA, so it can finish after showing backup codes
    totpSetupDone   Boolean  @default(false) @map("totp_setup_done")
    ip              String?  @db.VarChar(64)
    userAgent       String?  @map("user_agent") @db.VarChar(255)
    expiresAt       DateTime @map("expires_at")
    lastSeenAt      DateTime @default(now()) @map("last_seen_at")
    createdAt       DateTime @default(now()) @map("created_at")

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@map("sessions")
}

model BackupCode {
    id        String    @id @default(cuid())
    userId    String    @map("user_id")
    codeHash  String    @map("code_hash") @db.Char(64)
    usedAt    DateTime? @map("used_at")
    createdAt DateTime  @default(now()) @map("created_at")

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@map("backup_codes")
}

model AuditLog {
    id         String   @id @default(cuid())
    actorId    String?  @map("actor_id")
    action     String   @db.VarChar(64)
    targetType String?  @map("target_type") @db.VarChar(32)
    targetId   String?  @map("target_id") @db.VarChar(64)
    details    Json?
    ip         String?  @db.VarChar(64)
    createdAt  DateTime @default(now()) @map("created_at")

    actor User? @relation("actor", fields: [actorId], references: [id], onDelete: SetNull)

    @@index([createdAt])
    @@index([actorId])
    @@index([action])
    @@map("audit_logs")
}

// ─── Phase 2: Zad Security ─────────────────────────────────────────────

enum ScanType {
    SITE
    LEAK
    /// Breach-alert sign-up (email only). Moves to confirmed subscribers in phase 5.
    NOTIFY
}

enum RequestStatus {
    NEW
    CONTACTED
    SCANNING
    REPORT_SENT
    CONVERTED
    CLOSED
}

model ScanRequest {
    /// Short number shown to staff, e.g. #1042
    id              Int           @id @default(autoincrement())
    /// Id sent by zad.gg, so a retried delivery is stored once
    externalId      String?       @unique @map("external_id") @db.VarChar(64)
    type            ScanType
    status          RequestStatus @default(NEW)
    name            String?       @db.VarChar(120)
    email           String        @db.VarChar(191)
    phone           String?       @db.VarChar(40)
    target          String?       @db.VarChar(500)
    authorized      Boolean       @default(false)
    source          String?       @db.VarChar(64)
    ip              String?       @db.VarChar(64)
    userAgent       String?       @map("user_agent") @db.VarChar(255)
    assigneeId      String?       @map("assignee_id")
    /// Deadline for the assigned staff member
    dueAt           DateTime?     @map("due_at")
    /// Final summary written when the file is closed
    summary         String?       @db.Text
    /// A closed file is read-only until an admin reopens it
    closedAt        DateTime?     @map("closed_at")
    closedById      String?       @map("closed_by_id")
    statusChangedAt DateTime      @default(now()) @map("status_changed_at")
    createdAt       DateTime      @default(now()) @map("created_at")
    updatedAt       DateTime      @updatedAt @map("updated_at")

    assignee User?         @relation("assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
    closedBy User?         @relation("requestCloser", fields: [closedById], references: [id], onDelete: SetNull)
    notes    RequestNote[]
    findings Finding[]
    files    RequestFile[]

    @@index([status])
    @@index([type])
    @@index([createdAt])
    @@index([email])
    @@index([assigneeId])
    @@map("scan_requests")
}

enum Severity {
    CRITICAL
    HIGH
    MEDIUM
    LOW
    INFO
}

enum FindingStatus {
    OPEN
    FIXED
}

/// A vulnerability or observation found while working on a scan request.
model Finding {
    id             String        @id @default(cuid())
    requestId      Int           @map("request_id")
    title          String        @db.VarChar(200)
    severity       Severity
    status         FindingStatus @default(OPEN)
    affected       String?       @db.VarChar(500)
    description    String        @db.Text
    steps          String?       @db.Text
    recommendation String?       @db.Text
    authorId       String?       @map("author_id")
    createdAt      DateTime      @default(now()) @map("created_at")
    updatedAt      DateTime      @updatedAt @map("updated_at")

    request ScanRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
    author  User?       @relation("findingAuthor", fields: [authorId], references: [id], onDelete: SetNull)

    @@index([requestId])
    @@map("findings")
}

/// A file attached to a scan request (report, screenshot, evidence). Stored on disk outside public/.
model RequestFile {
    id           String   @id @default(cuid())
    requestId    Int      @map("request_id")
    name         String   @db.VarChar(255)
    mime         String   @db.VarChar(100)
    size         Int
    /// File name inside UPLOADS_DIR (random, never the original name)
    storageKey   String   @unique @map("storage_key") @db.VarChar(100)
    uploadedById String?  @map("uploaded_by_id")
    createdAt    DateTime @default(now()) @map("created_at")

    request    ScanRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
    uploadedBy User?       @relation("fileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

    @@index([requestId])
    @@map("request_files")
}

model RequestNote {
    id        String   @id @default(cuid())
    requestId Int      @map("request_id")
    authorId  String?  @map("author_id")
    body      String   @db.Text
    createdAt DateTime @default(now()) @map("created_at")

    request ScanRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
    author  User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)

    @@index([requestId])
    @@map("request_notes")
}

// ─── Phase 3: Certificates ─────────────────────────────────────────────

enum CertificateType {
    INTERNSHIP
    ATTENDANCE
    COURSE
}

enum CertificateStatus {
    ACTIVE
    REVOKED
}

/// Only used to write the Arabic sentence correctly (أتمّ / أتمّت).
enum Gender {
    MALE
    FEMALE
}

model Certificate {
    id           String            @id @default(cuid())
    /// Public number printed on the certificate and in the QR link, e.g. ZAD-2026-8K3F9Q
    code         String            @unique @db.VarChar(32)
    type         CertificateType
    status       CertificateStatus @default(ACTIVE)
    nameAr       String            @map("name_ar") @db.VarChar(160)
    nameEn       String            @map("name_en") @db.VarChar(160)
    gender       Gender            @default(MALE)
    email        String?           @db.VarChar(191)
    /// Type-specific fields (lib/certificates/types.ts → CertDetails)
    details      Json
    issuedAt     DateTime          @map("issued_at")
    /// Certificates issued together from one CSV upload share a batch id
    batchId      String?           @map("batch_id") @db.VarChar(32)
    issuedById   String?           @map("issued_by_id")
    revokedAt    DateTime?         @map("revoked_at")
    revokedById  String?           @map("revoked_by_id")
    revokeReason String?           @map("revoke_reason") @db.VarChar(500)
    createdAt    DateTime          @default(now()) @map("created_at")
    updatedAt    DateTime          @updatedAt @map("updated_at")

    issuedBy  User? @relation("certIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
    revokedBy User? @relation("certRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

    @@index([type])
    @@index([status])
    @@index([batchId])
    @@index([createdAt])
    @@index([email])
    @@map("certificates")
}

// ─── Email monitoring ──────────────────────────────────────────────────

enum MonitorStatus {
    ACTIVE
    PAUSED
}

enum MonitorFrequency {
    WEEKLY
    MONTHLY
}

model MonitoredEmail {
    id              String           @id @default(cuid())
    email           String           @unique @db.VarChar(191)
    status          MonitorStatus    @default(ACTIVE)
    frequency       MonitorFrequency @default(WEEKLY)
    /// "zad.gg/security" for sign-ups from the site, "manual" when staff add it
    source          String?          @db.VarChar(64)
    note            String?          @db.VarChar(500)
    /// Breach names already seen, so only new ones raise an alert
    knownBreaches   Json?            @map("known_breaches")
    breachCount     Int              @default(0) @map("breach_count")
    /// A breach appeared that staff have not reviewed yet
    hasNewBreach    Boolean          @default(false) @map("has_new_breach")
    lastNewBreachAt DateTime?        @map("last_new_breach_at")
    lastCheckedAt   DateTime?        @map("last_checked_at")
    nextCheckAt     DateTime         @default(now()) @map("next_check_at")
    lastError       String?          @map("last_error") @db.VarChar(255)
    addedById       String?          @map("added_by_id")
    createdAt       DateTime         @default(now()) @map("created_at")
    updatedAt       DateTime         @updatedAt @map("updated_at")

    addedBy User?        @relation("emailAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
    checks  EmailCheck[]

    @@index([status, nextCheckAt])
    @@index([hasNewBreach])
    @@map("monitored_emails")
}

model EmailCheck {
    id          String   @id @default(cuid())
    emailId     String   @map("email_id")
    checkedAt   DateTime @default(now()) @map("checked_at")
    breachCount Int      @default(0) @map("breach_count")
    /// Breaches seen for the first time in this check: [{ name, date }]
    newBreaches Json?    @map("new_breaches")
    /// Exposed data kinds (Arabic labels), e.g. ["كلمة المرور", "رقم الهاتف"]
    exposed     Json?
    error       String?  @db.VarChar(255)

    email MonitoredEmail @relation(fields: [emailId], references: [id], onDelete: Cascade)

    @@index([emailId, checkedAt])
    @@map("email_checks")
}

/// One row per breach check on zad.gg/security: the email (encrypted), an HMAC of it to count
/// repeat checks, and the public breach names that were found.
model BreachCheckStat {
    id          String   @id @default(cuid())
    emailHash   String   @map("email_hash") @db.Char(64)
    /// Full address, encrypted with AUTH_SECRET (lib/auth/secret-box.ts). Shown only in the dashboard.
    emailSealed String?  @map("email_sealed") @db.VarChar(600)
    /// Partly hidden address, e.g. "ze•••@icloud.com" (kept for rows from before full emails were logged)
    emailMasked String?  @map("email_masked") @db.VarChar(200)
    emailDomain String?  @map("email_domain") @db.VarChar(191)
    /// Not a free mail provider (gmail, icloud…): likely a company, a sales lead
    isCompany   Boolean  @default(false) @map("is_company")
    breachCount Int      @map("breach_count")
    breaches    Json?
    createdAt   DateTime @default(now()) @map("created_at")

    @@index([createdAt])
    @@index([emailHash])
    @@index([emailDomain])
    @@map("breach_check_stats")
}
