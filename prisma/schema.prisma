// Zad Admin database schema (MySQL 8).
// Phase 1: staff accounts, sessions, 2FA backup codes, audit log.

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

enum Role {
    ADMIN
    STAFF
}

model User {
    id                 String    @id @default(cuid())
    email              String    @unique @db.VarChar(191)
    name               String    @db.VarChar(120)
    passwordHash       String    @map("password_hash") @db.VarChar(255)
    role               Role      @default(STAFF)
    isActive           Boolean   @default(true) @map("is_active")
    mustChangePassword Boolean   @default(true) @map("must_change_password")
    /// Encrypted with AUTH_SECRET (lib/auth/secret-box.ts)
    totpSecret         String?   @map("totp_secret") @db.VarChar(255)
    /// Secret shown during setup, before the first code confirms it
    totpPendingSecret  String?   @map("totp_pending_secret") @db.VarChar(255)
    totpEnabledAt      DateTime? @map("totp_enabled_at")
    /// Last accepted TOTP time step, so a code cannot be used twice
    totpLastStep       Int?      @map("totp_last_step")
    failedLoginCount   Int       @default(0) @map("failed_login_count")
    lockedUntil        DateTime? @map("locked_until")
    lastLoginAt        DateTime? @map("last_login_at")
    createdAt          DateTime  @default(now()) @map("created_at")
    updatedAt          DateTime  @updatedAt @map("updated_at")

    sessions    Session[]
    backupCodes BackupCode[]
    auditLogs   AuditLog[]   @relation("actor")

    @@map("users")
}

model Session {
    id              String   @id @default(cuid())
    /// SHA-256 of the cookie token; the token itself is never stored
    tokenHash       String   @unique @map("token_hash") @db.Char(64)
    userId          String   @map("user_id")
    twoFactorPassed Boolean  @default(false) @map("two_factor_passed")
    /// Set on the login that just enabled 2FA, so it can finish after showing backup codes
    totpSetupDone   Boolean  @default(false) @map("totp_setup_done")
    ip              String?  @db.VarChar(64)
    userAgent       String?  @map("user_agent") @db.VarChar(255)
    expiresAt       DateTime @map("expires_at")
    lastSeenAt      DateTime @default(now()) @map("last_seen_at")
    createdAt       DateTime @default(now()) @map("created_at")

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@map("sessions")
}

model BackupCode {
    id        String    @id @default(cuid())
    userId    String    @map("user_id")
    codeHash  String    @map("code_hash") @db.Char(64)
    usedAt    DateTime? @map("used_at")
    createdAt DateTime  @default(now()) @map("created_at")

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@map("backup_codes")
}

model AuditLog {
    id         String   @id @default(cuid())
    actorId    String?  @map("actor_id")
    action     String   @db.VarChar(64)
    targetType String?  @map("target_type") @db.VarChar(32)
    targetId   String?  @map("target_id") @db.VarChar(64)
    details    Json?
    ip         String?  @db.VarChar(64)
    createdAt  DateTime @default(now()) @map("created_at")

    actor User? @relation("actor", fields: [actorId], references: [id], onDelete: SetNull)

    @@index([createdAt])
    @@index([actorId])
    @@index([action])
    @@map("audit_logs")
}
